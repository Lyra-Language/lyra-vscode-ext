// Data types
data ColorName = Red | Green | Blue

data Maybe<T> = Some T | None

data Result<T, E> = Ok T | Err E

data Tree<t> = Nil | Leaf t | Node { left: Tree, value: t, right: Tree }

print(int_point)

data CSSColor =
  | ColorName CSSColorName
  | Hex HexStr
  | RGB { r: i8, g: i8, b: i8 }
  | HSL { hue: Hue, sat: f64, light: f64, alpha: Alpha }

data Hue = HueDeg Angle | HueRadian Radian | HueTurn Turn

// newtypes
newtype Turn = f64
newtype CSSColorName = string where values("red", "green", "blue", "rebeccapurple", "aliceblue")
newtype Status = int16 where values(200, 404, 500)
newtype Angle = f64 where range(0..<360), precision(6, round_up)
newtype Radian = f64 where range(0..<=2*PI), precision(2, round_trunc)
newtype Alpha = f32 where range(0..<=1)
newtype HexStr = string where pattern(r/^#(?:[0-9a-fA-F]{3}){1,2}$/)

// Only multiples of 0.25 (for currency with quarter precision)
newtype Quarter = f64 where range(0..<=100), step(0.25)
// Valid: 0, 0.25, 0.5, 0.75, 1.0, 1.25, ...

// Degrees in 15° increments
newtype CompassHeading = i64 where range(0..<360), step(15)
// Valid: 0, 15, 30, 45, ..., 345

