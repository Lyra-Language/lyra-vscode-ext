// Structs
struct Point {
  x: f32,
  y: f32,
  y: f32 = 0.0, // Default value
}

struct Point2<t> {
  x: t,
  y: t,
}

a == b

// Generic args are inferred from the field values, so the turbofish is optional:
let int_point = Point2 { x: 123, y: 456 }       // inferred Point2<i32>
let float_point = Point2::<f64> { x: 1.23, y: 4.56 } // explicit turbofish still works

let blah = (x: i64, y: i64) -> Point => {
  let float_point: Point2<f32> = Point2 { x: f32(x), y: f32(y) }
  Point { x: float_point.x, y: float_point.y }
}

