// Async function example
let fetch_data<t> = async (url: string) -> t => {
  let result = await http.fetch(url)
  return json.parse(result.data)
}

// Default parameter examples
let greet = (name: string, prefix: string = "Hello") -> string => "${prefix} ${name}"

let clamp = (value: i64, min: i64 = 0, max: i64 = 100) -> i64 => value

let process = (items: []string, config: Config = get_default_config()) -> void => {}

// Function that returns a lambda
let make_sum_fn = (a: i64) -> (i64) -> i64 => (b) => a + b

// Function that takes a lambda as an argument
let doubled = map::<i64, i64>([1, 2, 3], (x) => 2 * x)

// Compose example
var pipeline = parse ->> validate ->> serialize

// Basic generator example
let counter = gen (start: i32) -> Gen<i32> => {
  var i = start
  loop {
    yield i
    i += 1
  }
}

// Async generator example
let stream = async gen (url: string) -> Gen<Packet> => {
  let data = await fetch(url)
  yield data
}

// Generator with filtering and transformation
pipeline = gen (items: []Item) -> Gen<Result> => {
  yield from filter(items)
  yield from transform(items)
}

// Given example
let result = sqrt(a_sq + b_sq) given {
  let a_sq = a * a
  let b_sq = b * b
}

// Chained postfix example
let something = MyStruct.method()[0].property

// Recursive function example
let fib = rec (n: i32, a: i32, b: i32) -> i32 {
  (0, a, _) => a,
  (n, a, b) => fib(n - 1, b, a + b)
}

// Immutable pointer
let ptr: ^f64 = &1.0

// Mutable pointer
let y: ^mut i32 = 0

// Pointer to Pointer type
let x: ^^i32 = 0

// Unsafe block example
unsafe {
  let ptr: ^mut i32 = 0
  ptr^ = 42
}

// Dereference example
let v = ptr^.field

// Trait
trait Printable {
  to_string: (Self) -> string,
  print: (Self) -> Void = (self) => log(self.to_string())
}
trait Converter<from, to> {
  convert: (from) -> to
}

impl Converter<string, i64> for StringParser {
  convert = (s) => parse_int(s)
}

impl Converter<i64, string> for IntFormatter {
  convert = (n) => int_to_string(n)
}

