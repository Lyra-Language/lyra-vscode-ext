for i in 1..=10 { } // ok: inclusive range

for i in 1..<10 { } // ok: exclusive range

for x in [1, 2, 3] { } // ok: iterating over an array

for c in "hello" { } // ok: iterating over characters in a string

let s: string = "hello"
for c in s { } // ok: iterating over characters in a string variable

let start: i64 = 1
let end: i64 = 5
for i in start..=end { } // ok: range with integer variables

for x in 42 { } // error: cannot iterate over non-iterable type

for x in 3.14 { } // error: cannot iterate over non-iterable type

for i in "a"..=10 { } // error: cannot compare string and integer

for i in (1, 2, 3) { } // error: cannot iterate over a tuple

let n: i64 = 5
for x in n { } // error: cannot iterate over non-iterable type

for i in "a"..=10 { } // error: cannot compare string and integer
for i in 1..="z" { } // error: cannot compare integer and string

for i in true..=10 { } // error: cannot compare boolean and integer
for i in 1..=true { } // error: cannot compare integer and boolean

let a: i32 = 0
let b: f64 = 10.0
for i in a..=b { } // error: cannot compare integer and float   
for i in b..=a { } // error: cannot compare float and integer

let st: string = "hello"
for i in st..=10 { } // error: cannot compare string and integer