{
    // `.lui` markup: XML-style comments; braces hold Lyra.
    "comments": {
        "blockComment": [ "<!--", "-->" ]
    },
    "brackets": [
        ["<!--", "-->"],
        ["<", ">"],
        ["{", "}"],
        ["(", ")"],
        ["[", "]"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
        { "open": "<!--", "close": " -->", "notIn": ["comment", "string"] }
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["\"", "\""],
        ["<", ">"]
    ]
}
